# Server configuration
PORT=5000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=xit_token

# JWT
JWT_SECRET=your_jwt_secret_key_change_this_2026

# Admin Login (password stored here — NOT in database)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@xit.com
ADMIN_PASSWORD=change_this_admin_password

# Blockchain (required for testnet/real sell payouts)
ADMIN_PRIVATE_KEY=

# Auto ROI cron — runs daily at 00:05 UTC (set false to disable)
AUTO_ROI_CRON=true
