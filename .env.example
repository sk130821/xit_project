# Server configuration
PORT=5000
NODE_ENV=production

# Frontend URL (for reference / future use)
FRONTEND_URL=https://xit.virajnandanigold.com

# Allowed browser origins (comma-separated)
CORS_ORIGINS=https://xit.virajnandanigold.com,http://localhost:5173

# MySQL Database (cPanel: use localhost + cPanel MySQL user/db name)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_cpanel_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=your_cpanel_mysql_db

# JWT — use a long random string in production
JWT_SECRET=your_jwt_secret_key_change_this_2026

# Admin Login (password stored here — NOT in database)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@xit.com
ADMIN_PASSWORD=change_this_admin_password

# Blockchain (required for testnet/real sell payouts)
ADMIN_PRIVATE_KEY=

# cPanel Cron Jobs chalayega — in-process timer production me band rakho
AUTO_ROI_CRON=false

# Required for /api/cron/daily-payout (cPanel Cron Jobs)
CRON_SECRET=change_this_long_random_cron_secret
