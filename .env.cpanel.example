# XIT Token — cPanel production (back.xittoken.co)
# Copy to: /home/USER/back.xittoken.co/.env

PORT=5000
NODE_ENV=production

FRONTEND_URL=https://xittoken.co
CORS_ORIGINS=https://xittoken.co,http://xittoken.co,https://www.xittoken.co,http://www.xittoken.co,http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_cpanel_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=your_cpanel_mysql_db

JWT_SECRET=change_this_long_random_string

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@xit.com
ADMIN_PASSWORD=change_this_admin_password

# Payout wallet private key (0x...) — buy XIT send + sell BNB payout
ADMIN_PRIVATE_KEY=

AUTO_ROI_CRON=false
CRON_SECRET=change_this_long_random_cron_secret

SMTP_HOST=mail.xittoken.co
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@xittoken.co
SMTP_PASS=your_email_account_password
MAIL_FROM=support@xittoken.co
MAIL_FROM_NAME=XIT Token Support
MAIL_REPLY_TO=support@xittoken.co
